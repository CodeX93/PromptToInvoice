# ── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Shown on /legal/terms and /legal/privacy: the operating company.
LEGAL_ENTITY="PromptToInvoice"
LEGAL_ADDRESS=
LEGAL_EMAIL=legal@prompttoinvoice.com
# Reverse proxy / load balancer IPs or CIDRs, comma-separated (see docs/deploy.md).
TRUSTED_PROXIES=

# ── Database ─────────────────────────────────────────────────────────
# App role (row-level security enforced)
DATABASE_URL=postgres://pti_app:pti_app@localhost:5432/pti
# System role (workers, webhooks, public invoice pages)
SYSTEM_DATABASE_URL=postgres://pti_system:pti_system@localhost:5432/pti
# Owner role, migrations only
MIGRATION_DATABASE_URL=postgres://pti:pti@localhost:5432/pti

# ── Secrets ──────────────────────────────────────────────────────────
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY=

# ── Sign-in providers (optional) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── AI (optional; AI drafting is hidden when unset) ──────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# "stub" runs a deterministic offline extractor (dev/e2e only)
AI_PROVIDER=anthropic

# ── Stripe (optional) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_APPLICATION_FEE_BPS=0

# ── Email ────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="PromptToInvoice <invoices@localhost>"

# ── Storage ──────────────────────────────────────────────────────────
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/files

# ── Subscriptions (our own billing; Stripe Price ids) ────────────────
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_SEAT_MONTH=
STRIPE_PRICE_SEAT_YEAR=
STRIPE_TRIAL_DAYS=14
